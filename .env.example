# Copy to .env.local. Everything is optional for local demo mode.

# Public URL of the app (used for the X OAuth callback)
APP_URL=http://localhost:3000

# X developer app (OAuth 2.0). Leave empty for free one-click mode (posts open in X's composer).
# Callback URL to register in the X developer portal: {APP_URL}/api/auth/x/callback
X_CLIENT_ID=
X_CLIENT_SECRET=

# Google Gemini. Leave empty to get placeholder drafts.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash

# Encrypts X tokens at rest. Required in production: any long random string.
ENCRYPTION_KEY=

# Protects /api/cron/autopilot. Required in production.
CRON_SECRET=

# Email (password reset). Free at https://resend.com. Without these, reset links are printed in the server log.
RESEND_API_KEY=
MAIL_FROM="X Studio <hello@yourdomain.com>"

# Payments with Lemon Squeezy (https://lemonsqueezy.com). Without all five, local development uses a
# built-in test checkout and production hides upgrades. Webhook URL: {APP_URL}/api/billing/webhook
LEMONSQUEEZY_API_KEY=
LEMONSQUEEZY_STORE_ID=
LEMONSQUEEZY_WEBHOOK_SECRET=
LEMONSQUEEZY_VARIANT_PRO=
LEMONSQUEEZY_VARIANT_CREATOR=

# Run autopilot every minute inside the server process (self-hosting / local).
AUTOPILOT_TIMER=1

# SQLite file location (default: ./data/app.db)
# DATABASE_PATH=
